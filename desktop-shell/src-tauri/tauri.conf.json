{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "browboxs",
  "version": "0.1.0",
  "identifier": "com.browboxs.desktop",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "browboxs",
        "url": "splash.html",
        "width": 420,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "browboxs",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:18910 http://127.0.0.1:* http://localhost:18910 http://localhost:* ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Fingerprint browser workbench",
    "longDescription": "Desktop client with embedded tenant server capability. Node domain for multi-device. No product WebUI.",
    "copyright": "browboxs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/browboxs-agent",
      "binaries/browboxs-server"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese"
        ]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {}
}
