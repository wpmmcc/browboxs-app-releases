{
  "schema_version": 1,
  "product": "browboxs",
  "product_version": "0.1.0",
  "channel": "stable",
  "github": {
    "owner": "wpmmcc",
    "repo": "browboxs-app-releases",
    "api": "https://api.github.com/repos/{owner}/{repo}/releases/latest",
    "notes": "APP channel only (desktop/agent/server/installers). Engines use github_engines / STORE.json — never mix giant engine trees into this repo long-term."
  },
  "github_engines": {
    "owner": "wpmmcc",
    "repo": "browboxs-engines-releases",
    "api": "https://api.github.com/repos/{owner}/{repo}/releases/latest",
    "store_path": "STORE.json",
    "notes": "ENGINE store channel. Each asset documents upstream OSS project. See packaged/engines/STORE.json and docs/DISTRIBUTION-AND-REPO-TOPOLOGY.md."
  },
  "engines_store": {
    "local": "engines/STORE.json",
    "binfarm_dev_base_url": "http://192.168.1.5:8788",
    "doc": "docs/DISTRIBUTION-AND-REPO-TOPOLOGY.md"
  },
  "modules": {
    "agent": {
      "version": "0.1.0",
      "binary": "browboxs-agent",
      "asset_pattern": "browboxs-agent-{target}"
    },
    "server": {
      "version": "0.1.0",
      "binary": "browboxs-server",
      "asset_pattern": "browboxs-server-{target}"
    },
    "desktop": {
      "version": "0.1.0",
      "binary": "browboxs-desktop",
      "asset_pattern": "browboxs-desktop-{target}"
    },
    "engine-fingerprint-chromium": {
      "version": "148.0.7778.215",
      "kind": "engine",
      "group": "packaged-chromium",
      "automation": "cdp",
      "asset_pattern": "fingerprint-chromium-{target}.tar.gz",
      "stable_path": "engines/fingerprint-chromium"
    },
    "engine-camoufox": {
      "version": "152.0.4-beta.28",
      "kind": "engine",
      "group": "packaged-firefox",
      "automation": "bidi",
      "asset_pattern": "camoufox-{target}.tar.gz",
      "stable_path": "engines/camoufox"
    },
    "engine-librewolf": {
      "version": "146.0.1-1",
      "kind": "engine",
      "group": "packaged-firefox",
      "automation": "bidi",
      "asset_pattern": "librewolf-{target}.tar.gz",
      "stable_path": "engines/librewolf"
    }
  },
  "stack": {
    "schema": "stack.v1",
    "product_version": "0.1.0",
    "doc": "docs/ENGINE-UI-PACKAGING.md",
    "lock": "engines/STACK.lock.yaml"
  },
  "targets": {
    "linux-x86_64": "x86_64-unknown-linux-gnu",
    "linux-aarch64": "aarch64-unknown-linux-gnu",
    "windows-x86_64": "x86_64-pc-windows-msvc",
    "windows-aarch64": "aarch64-pc-windows-msvc",
    "macos-x86_64": "x86_64-apple-darwin",
    "macos-aarch64": "aarch64-apple-darwin"
  },
  "packaging": {
    "doc": "docs/PACKAGING-TYPES-AND-COMPAT.md",
    "app_asset_pattern": "browboxs-<ver>-<os>-<arch>.tar.gz",
    "hot_update_asset": "tree",
    "install_types": {
      "tree": { "update_source": "github_app", "update_asset": "browboxs-<ver>-<os>-<arch>.tar.gz" },
      "portable": { "update_source": "github_app", "update_asset": "browboxs-<ver>-<os>-<arch>.tar.gz", "notes": "portable install still hot-updates via tree tarball" },
      "deb": { "update_source": "github_app", "update_asset": "browboxs-<ver>-<os>-<arch>.tar.gz", "notes": "apt package optional; module hot-update via GitHub tree" },
      "appimage": { "update_source": "github_app", "update_asset": "browboxs-<ver>-<os>-<arch>.tar.gz" },
      "nsis": { "update_source": "github_app", "update_asset": "browboxs-<ver>-<os>-<arch>.tar.gz" },
      "dmg": { "update_source": "github_app", "update_asset": "browboxs-<ver>-<os>-<arch>.tar.gz" }
    },
    "os_names": ["linux", "windows", "darwin"],
    "arch_names": ["x86_64", "aarch64"],
    "macos_filename_alias": "darwin",
    "default_slim": true
  }
}

